# ==========================================================================
# TT-B152 — plantilla de variables de entorno
#
#   cp .env.example .env   y rellena los valores marcados como CAMBIAR.
#   `.env` está en .gitignore: nunca subas secretos reales al repo.
#
# Todas las consume docker-compose.yml (servicios db / backend / frontend).
# ==========================================================================


# --------------------------------------------------------------------------
# Base de datos — MariaDB
# --------------------------------------------------------------------------
DB_USER=tt_user
DB_PASSWORD=ttpassword
DB_ROOT_PASSWORD=rootpassword
DB_NAME=tt_db

# URL que usa el backend. Dentro de Docker, el host es "db" (nombre del
# servicio). Debe concordar con las 3 variables de arriba.
#   mysql+pymysql://<DB_USER>:<DB_PASSWORD>@db:3306/<DB_NAME>
DATABASE_URL=mysql+pymysql://tt_user:ttpassword@db:3306/tt_db


# --------------------------------------------------------------------------
# Backend — FastAPI
# --------------------------------------------------------------------------
# Clave para firmar los JWT de sesión. OBLIGATORIA: el backend no arranca si
# falta, si tiene menos de 32 caracteres o si se deja este valor de ejemplo.
# Genera una aleatoria con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_por_una_clave_aleatoria_de_64_hex

# Orígenes permitidos por CORS, separados por coma (ej. https://app.midominio.mx).
# "*" basta en desarrollo: la sesión va en el header Authorization, no en cookies.
#CORS_ORIGINS=*
# Swagger (/docs) y OpenAPI públicos. Ponlo en false en producción.
#ENABLE_DOCS=true


# --------------------------------------------------------------------------
# Almacenamiento — Azure Blob / Azurite
# --------------------------------------------------------------------------
# En local se usa Azurite; esta cadena (AccountName/AccountKey) es el valor
# público y fijo que publica Microsoft para el emulador — NO es un secreto.
# Para Azure real, reemplázala por la cadena de tu Storage Account.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"

# El SAS que el backend devuelve al navegador debe apuntar a un host
# alcanzable DESDE EL NAVEGADOR (dentro de Docker es "azurite:10000", pero
# desde el equipo es "localhost:10000"). La firma del SAS no incluye el host.
# Opcional: si se omite, el backend usa este mismo valor por defecto.
AZURE_BLOB_PUBLIC_ENDPOINT=http://localhost:10000/devstoreaccount1


# --------------------------------------------------------------------------
# Correo — SMTP (recuperación de cuenta y verificación de canales)
# --------------------------------------------------------------------------
# En desarrollo se usa Mailpit (servicio "mailpit" en docker-compose.yml):
# captura todo el correo saliente sin entregarlo de verdad y lo muestra en
# su UI web -> http://localhost:8025. No requiere autenticación ni TLS.
# Para un SMTP real (producción), rellena host/puerto/usuario/contraseña
# y pon SMTP_USE_TLS=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=b152@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false


# --------------------------------------------------------------------------
# Telegram  (opcional: vinculación de cuenta y verificación de custodios)
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # sin @, para el deep link
TELEGRAM_WEBHOOK_SECRET=Super-secreto-xd


# --------------------------------------------------------------------------
# URLs del frontend  (el backend arma links "<url>?token=<token>" en correos)
# --------------------------------------------------------------------------
FRONTEND_RESET_URL=http://localhost:5173/reset-password
FRONTEND_CONFIRM_EMAIL_URL=http://localhost:5173/confirmar-correo
FRONTEND_CONFIRM_REGISTRO_URL=http://localhost:5173/confirmar-registro
FRONTEND_CONFIRM_CUSTODIO_URL=http://localhost:5173/confirmar-custodio


# --------------------------------------------------------------------------
# PayPal — pasarela para cambios a un plan de pago
# --------------------------------------------------------------------------
# Sin CLIENT_ID/SECRET, la vista de Suscripción ofrece "simular pago".
# Con credenciales de una app REST del PayPal Developer Dashboard se ejecuta
# el flujo real (create order -> aprobación del comprador -> capture).
#
#   Client ID / Secret: developer.paypal.com -> Apps & Credentials -> Sandbox
#   -> tu app. Son de la cuenta *business* de sandbox (la que cobra).
#   El pago se aprueba en el popup con una cuenta *personal* de sandbox.
PAYPAL_MODE=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD            # ISO-4217 de la cuenta sandbox. Peso = MXN (no "MXM").
                              # USD suele "just work" con una cuenta business de EE. UU.


# --------------------------------------------------------------------------
# Eliminación de cuenta con periodo de gracia
# --------------------------------------------------------------------------
# La cuenta entra en cola y un job la purga al vencer el plazo si no se
# canceló. FRONTEND_BASE_URL arma el link "inicia sesión para cancelar".
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_DELETION_REMINDER_DAYS=3
FRONTEND_BASE_URL=http://localhost:5173


# --------------------------------------------------------------------------
# Interruptor de Hombre Muerto (DMS)
# --------------------------------------------------------------------------
# activo -> alerta (75% del umbral) -> gracia (umbral vencido, votan custodios)
# -> gracia_reduccion (custodios avalaron vida) -> liberado. Un barrido horario
# evalúa las transiciones por tiempo; los votos se evalúan al recibirlos.
DMS_ALERTA_PORCENTAJE=0.75      # fracción del umbral a la que se entra en 'alerta'
DMS_REDUCCION_DIAS=30           # temporizador del estado 'gracia_reduccion'
DMS_MAX_RECONFIRMACIONES=2      # reconfirmaciones de vida por custodios antes de liberar
DMS_COOLDOWN_RECONFIRMACION_HORAS=24  # mínimo entre rondas de 'vida' para que cuenten como reconfirmación
DMS_VOTO_TTL_DIAS=14            # vigencia de un voto de custodio dentro de su ronda
DMS_RECOVERY_WINDOW_DIAS=30     # ventana de recuperación por bóveda tras el disparo (RN-002)
FRONTEND_DMS_VOTO_URL=http://localhost:5173/atestacion   # página pública de atestación del custodio


# --------------------------------------------------------------------------
# Frontend — React / Vite
# --------------------------------------------------------------------------
# URL pública del backend desde el navegador. Déjala vacía/comentada: el
# frontend entonces usa el mismo host con el que se cargó la página (sirve
# igual desde localhost que desde tu IP de LAN al probar desde el celular —
# "localhost" fijo aquí apuntaría al celular mismo, no a tu backend). Pon un
# valor solo si el backend vive en un host/puerto distinto al de la página.
#VITE_API_URL=http://localhost:8000
